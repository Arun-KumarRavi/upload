# ============================================================================
# Environment Variables - Example
# Copy this file to .env and update with your values
# ============================================================================

# ---- Node Environment ----
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ---- Database Configuration ----
DB_HOST=mysql-instance.c2i3q3q.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_secure_password_here
DB_NAME=mydb
DB_SSL=true

# ---- Redis Configuration ----
REDIS_HOST=redis.db4fresh.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ---- JWT Configuration ----
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# ---- Razorpay Configuration ----
RAZORPAY_KEY_ID=pk_live_xxxxxx
RAZORPAY_SECRET=sk_live_xxxxxx

# ---- Cloudinary Configuration ----
CLOUDINARY_CLOUD_NAME=db4fresh
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- SMTP Configuration (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@db4fresh.com

# ---- AWS Configuration ----
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=233542590
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ---- API Configuration ----
API_URL=https://api.db4fresh.example.com
FRONTEND_URL=https://db4fresh.example.com
ALLOWED_ORIGINS=https://db4fresh.example.com,https://api.db4fresh.example.com

# ---- Logging ----
LOG_FORMAT=json
LOG_LEVEL=info

# ---- Feature Flags ----
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_EMAIL_VERIFICATION=true
